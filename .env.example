# Copy this file to .env and fill in the values from the Firebase console:
# Project Settings → General → Your apps → Web app → SDK setup and configuration

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "false" to disable emulator connections in dev (e.g. when testing against production).
# Omit or set to "true" to use local emulators (default when running npm run dev).
VITE_USE_EMULATOR=true
