rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────────────────────

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Returns the current calendar year derived from the request timestamp.
    // Used to validate submission year server-side.
    function currentYear() {
      return int(request.time.toMillis() / 1000 / 60 / 60 / 24 / 365) + 1970;
    }

    // ─── curated_songs ─────────────────────────────────────────────────────────
    // Public read (visible only). Admin write only.

    match /curated_songs/{songId} {
      allow read: if resource.data.visible == true;
      allow list: if resource.data.visible == true;

      // Document ID must equal the year — enforces one song per year
      allow create: if isAdmin() && songId == string(request.resource.data.year);
      allow update, delete: if isAdmin();

      // Submitters may update their own submitterName (e.g. after a display name change).
      // Also allows backfilling uid on legacy documents that were promoted before uid was stored.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['submitterName', 'uid'])
        && (
          // Document already has a matching uid
          resource.data.uid == request.auth.uid
          // OR uid is absent and is being set to the requester's own uid for the first time
          || (!('uid' in resource.data) && request.resource.data.uid == request.auth.uid)
        );

      // Admins can read hidden songs too
      allow read: if isAdmin();
    }

    // ─── submissions ───────────────────────────────────────────────────────────
    // Public read (visible only). Any authenticated user (incl. anonymous) can
    // create their own submission. Admin can update or delete.

    match /submissions/{submissionId} {
      allow read: if resource.data.visible == true;
      allow list: if resource.data.visible == true;

      allow create: if request.auth != null
        // Submitter can only write under their own UID
        && request.resource.data.uid == request.auth.uid
        // Year must be in valid submission range
        && request.resource.data.year >= 2001
        && request.resource.data.year <= currentYear()
        // Email must never appear on a submission document
        && !('email' in request.resource.data)
        // Visitors cannot self-promote — only admins can set this via update
        && !('promoted' in request.resource.data)
        // Required fields must be present
        && request.resource.data.keys().hasAll(['year', 'title', 'artist', 'story', 'submitterName', 'uid', 'createdAt', 'updatedAt', 'visible'])
        // New submissions must default to visible
        && request.resource.data.visible == true;

      allow update, delete: if isAdmin();

      // Owners can update their own submissions but cannot touch admin-only fields
      allow update: if isOwner(resource.data.uid)
        // Immutable fields must not change
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.visible == resource.data.visible
        && request.resource.data.promoted == resource.data.get(['promoted'], false)
        && request.resource.data.createdAt == resource.data.createdAt
        // updatedAt must be present and must differ from the stored value (i.e. refreshed)
        && 'updatedAt' in request.resource.data
        && request.resource.data.updatedAt != resource.data.updatedAt
        // Year must stay in valid range
        && request.resource.data.year >= 2001
        && request.resource.data.year <= currentYear()
        // Email must never appear on a submission document
        && !('email' in request.resource.data);

      // Owners can read their own submissions (including hidden ones)
      allow read, list: if isOwner(resource.data.uid);

      // Admins can read hidden submissions too
      allow read: if isAdmin();
    }

    // ─── votes ─────────────────────────────────────────────────────────────────
    // Anyone can read (so vote counts are public).
    // Only verified (non-anonymous) users can vote, and only under their own UID.
    // Document ID must be {songCollection}_{songId}_{uid} to prevent duplicates.

    match /votes/{voteId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.uid == request.auth.uid
        && voteId == request.resource.data.songCollection + '_' + request.resource.data.songId + '_' + request.auth.uid;

      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // ─── user_profiles ─────────────────────────────────────────────────────────
    // Only the document owner or an admin can read or write. No public access.

    match /user_profiles/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

  }
}
